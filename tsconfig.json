{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],

    "paths": {
      "@components/*": ["./src/_components/*"],
      "@data/*": ["./src/data/*"],
      "@lib/*": ["./src/_lib/*"],
      "@public/*": ["./public/*"],
      // PATHS FOR ACHEIVEMENTS
      "@achievements/*": ["./public/achievements/*"],
      // PATHS FOR CODING PROJECTS
      "@featuredCodingProjects/*": ["./public/coding-projects/featured/*"],
      "@otherCodingProjects/*": ["./public/coding-projects/others/*"],
      "@skillLogos/*": ["./public/coding-projects/skill-logos/*"],
      // PATHS FOR DESIGN PROJECTS
      "@uiuxDesignProjects/*": ["./public/design-projects/UIUX/*"],
      "@productDesignProjects/*": ["./public/design-projects/product-design/*"],
      "@graphicDesignProjects/*": ["./public/design-projects/graphic-design/*"],
      // PATHS FOR PARTICIPATION
      "@participation2024/*": ["./public/participation/2024/*"],
      "@participation2025/*": ["./public/participation/2025/*"]
    }
  },
  "include": [
    "video.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
