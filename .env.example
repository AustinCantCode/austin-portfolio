# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables (Production
# and Preview). Everything is optional: a feature stays off until its key
# is set. See docs/CMS.md for step-by-step setup.

# --- Analytics (PostHog) -------------------------------------------------
# PostHog → Project settings → Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
# Region host. Leave as is for US projects; EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Contact form (Resend) ------------------------------------------------
# resend.com → API Keys. Without it, the form offers to email you instead.
RESEND_API_KEY=
# Optional sender, once your domain is verified in Resend, e.g.
# Austin Sia <hello@austinsia.com>. Defaults to Resend's test sender.
CONTACT_FROM=

# --- Content editor (Keystatic at /keystatic) ------------------------------
# Password asked before /keystatic opens on the live site (use a long,
# random one). Required: without it the live CMS stays locked.
CMS_PASSWORD=
# GitHub usernames allowed to sign in, comma-separated. Required live.
CMS_ALLOWED_USERS=AustinCantCode
# From the GitHub App Keystatic creates for you (docs/CMS.md, "Connect the
# live CMS"). Keystatic shows all four values once the app is created.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Local development only: set to "github" to edit the GitHub copy from
# your computer. Leave empty to edit local files. Ignored on the live site.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# --- CV PDF export (pnpm cv:pdf, on your computer only) -------------------
# Optional path to Chrome/Chromium if you haven't run
# `npx playwright install chromium`, e.g. on macOS:
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=
