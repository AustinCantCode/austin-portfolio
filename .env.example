# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.

# PostHog project API key (PostHog → Project settings → Project API key).
# Analytics stays off while this is empty.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. PostHog region host. Leave as is for US projects;
# use https://eu.i.posthog.com for EU projects.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
